# Copia este archivo a .env para desarrollo local (npm run dev). NUNCA subas .env a git.

# ── Web ──────────────────────────────────────────────────────────────
PORT=3000
# Clave para abrir http://localhost:3000/qr?key=...  (si la omites se genera una y se imprime en el log)
ADMIN_KEY=cambia-esto-por-una-clave-larga

# ── Sesión de WhatsApp ───────────────────────────────────────────────
# En la nube gratuita el disco se borra: guarda la sesión en MongoDB (Atlas gratis).
# Si lo dejas vacío se usa disco local (.wwebjs_auth), como hasta ahora.
MONGODB_URI=
SESSION_ID=avior-bot

# ── Correo de tickets ────────────────────────────────────────────────
TICKET_TO=helpdesk@avior.com.ve
MAIL_PROVIDER=smtp

# smtp (SMTP AUTH con usuario/clave)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=helpdesk@avior.com.ve
SMTP_PASS=

# graph (Microsoft Graph, recomendado si el SMTP básico ya no funciona)
# MAIL_FROM=helpdesk@avior.com.ve
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

# ── Comportamiento ───────────────────────────────────────────────────
IDLE_TIMEOUT_MIN=10        # inactividad antes de cerrar un menú/formulario
HANDOFF_SILENCE_MIN=120    # el bot calla este tiempo tras pasar el chat a un analista
HINT_COOLDOWN_MIN=360      # no repetir "escribe menu" a quien escribe cosas sueltas
GREET_UNKNOWN=true         # false = el bot no responde a lo que no entiende
# ADMIN_WHATSAPP=584121234567   # avisa por WhatsApp si un ticket no se pudo enviar por correo
